# Owns the private tmux server (`tmux -L crc`) that hosts kept Claude Code
# remote-control sessions, and resumes them when it starts. Generated by
# `make install`; @BINDIR@, @TMUX@ and @PATH@ are filled in from the install.
[Unit]
Description=Keep Claude Code remote-control sessions running

[Service]
# The user manager's own PATH may not even have python3 (NixOS); this is the
# one crc was installed with. The claude sessions themselves get their PATH
# from a login shell.
Environment="PATH=@PATH@"
# tmux daemonizes its server; systemd tracks it as the main process, and every
# claude it hosts lands in this unit's cgroup.
Type=forking
ExecStart=@TMUX@ -L crc new-session -d -s crc -n shell
# A failed resume must not fail the unit: the others still run, and
# `crc ls` shows what went wrong.
ExecStartPost=-@BINDIR@/crc restore
ExecStop=@TMUX@ -L crc kill-server
# restore waits up to two minutes for the network, then a minute per folder.
TimeoutStartSec=15min

[Install]
WantedBy=default.target
