#!/usr/bin/env python3
"""crc -- keep Claude Code remote-control sessions running across reboots.

    crc new [DIR] [--name N] [-i] [--trust] [-- ARGS]
                                        start `claude rc` in DIR and keep it;
                                        -i: a terminal `claude --remote-control`
            [--resume ID] [--channel CH ...] [--accept-channels]
                                        -i continuing conversation ID, with
                                        development channels
    crc adopt [DIR] [--pid N]           keep a session already running in DIR
    crc ls [--json]                     show kept sessions and their state
    crc sync                            record sessions opened on kept hosts (timer)
    crc restore [--dry-run]             bring back every kept session (boot)
    crc attach                          attach to the tmux session hosting them
    crc pause DIR... [--force]          stop kept hosts and keep them stopped,
    crc pause --under PATH [--force]    through the timer and reboots
    crc resume DIR... | --under PATH    start paused hosts again
    crc poke DIR... | --under PATH [--dry-run]
                                        re-queue sessions a live rc host has
                                        stopped serving
    crc rm DIR [--keep-registration]    stop keeping DIR, stop it, release it
    crc move OLD NEW [--trust]          carry a kept session to a moved folder
    crc channel DIR [CH ...] [--accept | --no-accept | --clear]
                                        development channels for a terminal host
    crc release [DIR] [--force]         release a dead host's stale registration
    crc stale                           list stale registrations in every folder
    crc doctor                          check what restore depends on

Kept sessions run in windows of a private tmux server (`crc attach`), which
the claude-rc-keeper user unit owns. After a reboot the unit resumes each one:
an rc host on its old environment with every session it was serving, first
releasing any registration another dead host left on the folder (the "This
folder is already served" error); a terminal session with
`claude --resume <conversation> --remote-control`, which keeps its claude.ai
link.
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import time

LIBDIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib")
sys.path.insert(0, LIBDIR)
import bridge                    # noqa: E402
import keeper                    # noqa: E402
import tmuxctl                   # noqa: E402


def die(msg, code=1):
    print(f"crc: {msg}", file=sys.stderr)
    sys.exit(code)


def folder(arg):
    return os.path.realpath(arg or os.getcwd())


def cmd_new(a):
    d = folder(a.dir)
    if not os.path.isdir(d):
        die(f"{d} is not a directory")
    entries = keeper.load()
    w = tmuxctl.window_for(d)
    if d in entries and w is not None and not w.dead:
        die(f"{d} is already kept and running; `crc attach` to see it")
    if d in entries and entries[d].get("paused"):
        die(f"{d} is kept but paused; `crc resume {d}` starts it again")
    p = bridge.read_pointer(d)
    if p is not None and bridge.host_alive(p):
        die(f"a claude rc (pid {p.pid}, session {p.session_id}) is already "
            f"serving {d}; `crc adopt` keeps it instead")
    if a.resume or a.channel:
        a.interactive = True        # only a terminal session resumes or loads channels
    if d in entries and (a.resume or a.channel):
        die(f"{d} is already kept; `crc rm` it first")
    bad = [c for c in a.channel if not keeper.CHANNEL_ENTRY.match(c)]
    if bad:
        die(f"not a channel: {', '.join(bad)}; use server:NAME or plugin:NAME@MARKETPLACE")
    if a.accept_channels and not a.channel:
        die("--accept-channels needs --channel")
    if a.resume:
        resume_from(d, a.resume)
    name = a.name or os.path.basename(d) or d
    channels = list(dict.fromkeys(a.channel))
    if a.interactive:
        argv = (["claude", *(["--resume", a.resume] if a.resume else []), "--remote-control",
                 *([a.name] if a.name else []), *a.args]
                + ([keeper.CHANNEL_FLAG, *channels] if channels else []))
        confirm = keeper.interactive_started
    else:
        argv = keeper.rc_argv(a.args, a.name)
        confirm = keeper.rc_started(d)
    wid, r, err = keeper.start(d, name, argv, confirm, trust=a.trust,
                               channels=channels if a.accept_channels else None)
    if err is not None:
        left = (f"\n(window {wid} left open in `crc attach` for a closer look)"
                if tmuxctl.get(wid) is not None else "")
        die(f"{argv[0]} {argv[1]} did not start in {d}:\n{err}{left}")
    e = {"name": name, "args": a.args, "added": keeper.now(),
         "updated": keeper.now(), "last_status": "running", "last_error": None}
    if a.interactive:
        e.update(kind="interactive", session_id=r.bridge_session_id,
                 transcript_id=r.transcript_id)
        if channels:
            e.update(channels=channels, accept_channels=a.accept_channels,
                     channel_check=keeper.check_channels(d, r.pid, channels))
    else:
        e.update(kind="rc", session_id=r.session_id, environment_id=r.environment_id,
                 sessions=[])
    entries[d] = e
    keeper.save(entries)
    print(f"keeping {d}\n  session {e['session_id']}\n  window  {wid} (crc attach)")
    if a.resume:
        print(f"  link    https://claude.ai/code/{e['session_id']} (a conversation "
              f"born on a claude rc host gets a new one the first time it is resumed)")
    for line in channel_lines(e):
        print(f"  {line}")


def resume_from(d, tid):
    """Make conversation tid resumable in d: `claude --resume` looks it up under
    d's project key. Refuses one that is open in a running process, since two
    processes would then write the same conversation."""
    found = bridge.find_transcript(tid)
    if not found:
        die(f"no conversation {tid} under {bridge.claude_dir()}/projects "
            f"(the id is the transcript's file name, a UUID)")
    for s in bridge.live_sessions():
        if s.transcript_id == tid:
            die(f"conversation {tid} is open in pid {s.pid} ({s.cwd}); exit it, or "
                f"archive its claude.ai session, first")
    here = os.path.join(bridge.claude_dir(), "projects", bridge.project_key(d))
    if here in found:
        return
    if len(found) > 1:
        die(f"conversation {tid} is under several folders: " + ", ".join(found))
    for n in bridge.copy_transcript(tid, found[0], d):
        print(f"copied {n} from {found[0]}")


def cmd_adopt(a):
    """Prefer a `claude rc` host; otherwise a terminal session with remote
    control on. A folder can have both, but only one entry, and the rc host is
    the one the server ties to the folder."""
    d = folder(a.dir)
    e = {"name": os.path.basename(d) or d, "args": [], "added": keeper.now(),
         "updated": keeper.now(), "last_status": "elsewhere", "last_error": None}
    p = bridge.read_pointer(d)
    if a.pid is None and p is not None and bridge.host_alive(p):
        e.update(kind="rc", session_id=p.session_id, environment_id=p.environment_id,
                 sessions=[])
        keeper.sync_one(d, e, server=keeper.fetch_server_sessions(
            lambda m: print(f"crc: {m}", file=sys.stderr)))
        pid = p.pid
    else:
        found = keeper.interactive_in(d, bridge.live_sessions())
        if a.pid is not None:
            found = [s for s in found if s.pid == a.pid]
        if not found:
            die(f"no running claude rc, and no terminal claude with remote control "
                f"on, in {d}" + (f" with pid {a.pid}" if a.pid else ""))
        if len(found) > 1:
            die(f"several sessions in {d}; pick one with --pid: "
                + ", ".join(f"{s.pid} ({s.bridge_session_id})" for s in found))
        s = found[0]
        e.update(kind="interactive", session_id=s.bridge_session_id,
                 transcript_id=s.transcript_id)
        pid = s.pid
    entries = keeper.load()
    entries[d] = e
    keeper.save(entries)
    more = f" + {len(e['sessions'])} more" if e.get("sessions") else ""
    print(f"keeping {d} ({e['kind']}, session {e['session_id']}{more})\n"
          f"It stays where it is (pid {pid}) until it exits; from the next "
          f"restore on it runs under crc.")


STATE_TEXT = {keeper.RUNNING: "running ({})",
              keeper.ELSEWHERE: "running outside crc (pid {})",
              keeper.OCCUPIED: "blocked: another live host (pid {})",
              keeper.RELEASE: "stopped; stale registration {} to release",
              keeper.STUCK: "STUCK, not serving: window {}",
              keeper.PAUSED: "paused since {} (`crc resume` starts it)",
              keeper.LAUNCH: "stopped"}


def cmd_ls(a):
    entries = keeper.load()
    if a.json:
        return ls_json(entries)
    if not entries:
        print("nothing kept; add a folder with `crc new` or `crc adopt`")
        return
    for d, e in sorted(entries.items()):
        action, detail = keeper.state_of(d, e)
        state = STATE_TEXT[action].format(detail)
        more = f" + {len(e['sessions'])} more" if e.get("sessions") else ""
        print(f"{e.get('name', '?'):20} {state}\n{'':20} {d}\n"
              f"{'':20} {keeper.kind(e)} {e['session_id']}{more}")
        if keeper.kind(e) == "rc" and e.get("synced_from") != "server":
            print(f"{'':20} sessions so far seen only from local processes; "
                  f"idle ones may be missing until `crc sync` reaches the server")
        for line in channel_lines(e):
            print(f"{'':20} {line}")
        if e.get("paused") and action != keeper.PAUSED:
            print(f"{'':20} paused since {e['paused']}, but running anyway; crc will "
                  f"not start it again once it stops")
        if action not in (keeper.RUNNING, keeper.ELSEWHERE) and e.get("last_error"):
            last = e["last_error"].splitlines()[-1]
            print(f"{'':20} last attempt: {e.get('last_status')}: {last}")


def ls_json(entries):
    """Like ls, with each session's title (from the server, if reachable) and
    the pid and local name of the process serving it, if one is running."""
    live = bridge.live_sessions()
    by_bridge = {bridge.canonical(s.bridge_session_id): s
                 for s in live if s.bridge_session_id}
    server = keeper.fetch_server_sessions(
        lambda m: print(f"crc: {m}", file=sys.stderr))
    titles = {s.id: s for s in server or []}
    out = []
    for d, e in sorted(entries.items()):
        action, detail = keeper.state_of(d, e)
        sessions = []
        for sid in [e["session_id"], *e.get("sessions", [])]:
            proc, srv = by_bridge.get(bridge.canonical(sid)), titles.get(bridge.canonical(sid))
            sessions.append({"id": sid,
                             "title": srv.title if srv else None,
                             "status": srv.status if srv else None,
                             "connection": srv.connection or None if srv else None,
                             "pid": proc.pid if proc else None,
                             "local_name": proc.name or None if proc else None})
        out.append({"dir": d, "name": e.get("name"), "kind": keeper.kind(e),
                    "state": action, "detail": detail,
                    "environment_id": e.get("environment_id"),
                    "transcript_id": e.get("transcript_id"),
                    "sessions": sessions,
                    "synced_from": e.get("synced_from"),
                    "paused": e.get("paused"),
                    "channels": e.get("channels") or [],
                    "accept_channels": bool(e.get("accept_channels")),
                    "channel_check": e.get("channel_check"),
                    "last_status": e.get("last_status"),
                    "last_error": e.get("last_error")})
    json.dump(out, sys.stdout, indent=2)
    print()


def cmd_sync(a):
    """One call to the server's session list, plus /proc and ~/.claude. With
    --revive (the timer), also start again hosts that stopped or lost the
    server, which Claude Code itself gives up on after 10 minutes."""
    if not a.revive:
        entries = keeper.load()
        if keeper.sync_all(entries):
            keeper.save(entries)
        return
    with keeper.locked(block=False) as got:
        if not got:
            print("another crc is changing hosts; skipping this round")
            return
        entries = keeper.load()
        changed = keeper.sync_all(entries)
        changed |= keeper.revive_all(entries)
        if changed:
            keeper.save(entries)


def cmd_restore(a):
    entries = keeper.load()
    if not entries:
        return 0
    if a.dry_run:
        # Work on a copy that is never saved: sync may add sessions to it,
        # which shows what a real restore would re-queue.
        keeper.sync_all(entries, log=lambda m: print(f"(sync) {m}"))
        for d, e in sorted(entries.items()):
            if e.get("paused"):
                print(f"{d}: paused since {e['paused']}; would skip")
                continue
            if not os.path.isdir(d):
                print(f"{d}: folder missing (unmounted?); would skip")
                continue
            keeper.restore_one(d, e, dry_run=True)
        return 0
    if not a.no_wait and not keeper.wait_network():
        print("network still unreachable; trying anyway", file=sys.stderr)
    # The server knows every session on each environment, including any the
    # timer had not yet recorded; ask before restoring rather than after.
    if keeper.sync_all(entries):
        keeper.save(entries)
    ok = True
    for d, e in sorted(entries.items()):
        if e.get("paused"):
            print(f"{d}: paused since {e['paused']}; skipped (`crc resume` starts it)")
            continue
        if not os.path.isdir(d):
            print(f"{d}: folder missing (unmounted?); skipped")
            e["last_status"], e["last_error"] = "failed", "folder missing"
            ok = False
            continue
        ok &= keeper.restore_one(d, e)
        keeper.save(entries)
    # Hosts that were already running may have gained sessions since; record
    # them now rather than waiting for the timer.
    if keeper.sync_all(entries):
        keeper.save(entries)
    return 0 if ok else 1


def cmd_attach(a):
    if not tmuxctl.session_up():
        die("no crc tmux session; `crc restore` or `crc new` starts one")
    env = {k: v for k, v in os.environ.items() if k != "TMUX"}
    os.execvpe("tmux", ["tmux", "-S", tmuxctl.socket(), "attach", "-t",
                        f"={tmuxctl.SESSION}"], env)


def stop_window(w, interactive=False, force=True):
    """Exit the way it would in a terminal: Ctrl-C for an rc host; for a
    terminal session, Escape (abandon any turn in progress) then /exit.

    Where /exit asks about unsent feedback drafts, the window is closed
    there, which keeps them; crc never sends or deletes them. Where it asks
    about background work, force stops the work; otherwise crc answers Stay
    and leaves the session running. Returns (what is left of its process
    tree afterwards, as (pid, program); why it was left running, or None).
    """
    tree = {} if w.dead else {p: bridge.proc_start(p)
                              for p in [w.pid, *keeper.descendant_pids(w.pid)]}
    if interactive:
        tmuxctl.tmux("send-keys", "-t", w.id, "Escape", check=False)
        time.sleep(0.5)
        tmuxctl.tmux("send-keys", "-t", w.id, "/exit", "Enter", check=False)
    else:
        tmuxctl.interrupt(w.id)
    for _ in range(20):
        time.sleep(0.5)
        cur = tmuxctl.get(w.id)
        if cur is None or cur.dead:
            break
        q = keeper.exit_prompt(tmuxctl.capture(w.id, lines=40)) if interactive else None
        if q == keeper.EXIT_DRAFTS:
            print(f"{w.dir}: closed the window at {q}; the drafts stay queued, "
                  f"unsent, for its next /exit")
            break
        if q == keeper.EXIT_BACKGROUND and not force:
            tmuxctl.tmux("send-keys", "-t", w.id, "Escape", check=False)     # Stay
            return [], "it has background work running, and /exit would stop it"
        if q == keeper.EXIT_BACKGROUND:
            print(f"{w.dir}: stopping its background work, as /exit asked")
            break
    tmuxctl.kill(w.id)
    for _ in range(10):
        # A pid counts only while it is the same process: same start time,
        # and not a zombie (which has no cmdline and holds no folder).
        left = [(p, os.path.basename(argv[0])) for p, t in tree.items()
                for argv in [keeper.cmdline(p)] if argv and bridge.proc_start(p) == t]
        if not left:
            break
        time.sleep(0.5)
    return left, None


def cmd_rm(a):
    d = folder(a.dir)
    entries = keeper.load()
    e = entries.pop(d, None)
    if e is None:
        die(f"{d} is not kept")
    w = tmuxctl.window_for(d)
    if w is not None:
        stop_window(w, keeper.kind(e) == "interactive")
    keeper.save(entries)
    print(f"stopped keeping {d}")
    if keeper.kind(e) == "interactive":
        return              # registers no environment, so nothing to release
    p = bridge.read_pointer(d)
    if p is not None and bridge.host_alive(p):
        print(f"claude rc pid {p.pid} is still running outside crc; left alone")
        return
    if a.keep_registration:
        return
    # Ctrl-C keeps the registration for `claude rc -c`. Leaving it would block
    # the next `claude rc` in this folder, which is the problem crc exists for.
    envs = {e.get("environment_id")} | ({p.environment_id} if p else set())
    for env in sorted(x for x in envs if x):
        try:
            keeper.release(env, p)
            print(f"released {env}")
        except bridge.BridgeError as err:
            print(f"could not release {env}: {err}", file=sys.stderr)


def targets(a, entries):
    """The kept folders pause and resume act on: the DIRs named, or with
    --under every kept folder at or below PATH."""
    if bool(a.dirs) == bool(a.under):
        die("name the folders, or give --under PATH for every kept folder below it")
    if a.under:
        top = folder(a.under).rstrip("/")
        ds = [d for d in sorted(entries) if d == top or d.startswith(top + "/")]
        if not ds:
            die(f"nothing kept at or under {top or '/'}")
        return ds
    ds = list(dict.fromkeys(folder(x) for x in a.dirs))
    missing = [d for d in ds if d not in entries]
    if missing:
        die("not kept: " + ", ".join(missing))
    return ds


# What a session's status says it is doing, for pause's refusals.
BUSY_TEXT = {"busy": "mid-turn", "waiting": "waiting on a permission answer",
             "shell": "running a shell command (perhaps in the background)"}


def cmd_pause(a):
    """Stop kept hosts on purpose, and keep them stopped -- the timer and
    restore at boot skip them -- until `crc resume`. Each keeps its entry,
    its environment and its claude.ai links: the stop is the same Ctrl-C or
    /exit `crc rm` uses, and resuming is a restore. A host with a session
    mid-turn is left running unless --force."""
    entries = keeper.load()
    ds = targets(a, entries)
    if any(keeper.kind(entries[d]) == "rc" for d in ds):
        # Once an rc host is down only the server knows its idle sessions;
        # record any opened since the timer last ran, so resume re-queues them.
        if keeper.sync_all(entries):
            keeper.save(entries)
    live = bridge.live_sessions()
    ok = True
    for d in ds:
        e = entries[d]
        w = tmuxctl.window_for(d)
        cut = keeper.busy(e, w, live)
        what = "; ".join(f"{s.bridge_session_id or s.transcript_id} is "
                         f"{BUSY_TEXT.get(s.status, s.status)}" for s in cut)
        if cut and not a.force:
            print(f"{d}: not paused: {what}; wait for it, or --force to stop it "
                  f"anyway", file=sys.stderr)
            ok = False
            continue
        since = e.get("paused")
        before = {k: e.get(k) for k in ("paused", "last_status", "last_error")}
        e["paused"] = since or keeper.now()
        e["last_status"], e["last_error"] = "paused", None
        e.pop("disconnected_at", None)
        keeper.save(entries)
        left = []
        if w is not None:
            if cut:
                print(f"{d}: stopping it anyway: {what}")
            left, kept = stop_window(w, keeper.kind(e) == "interactive", force=a.force)
            if kept:
                e.update(before)
                if before["paused"] is None:
                    del e["paused"]
                keeper.save(entries)
                print(f"{d}: not paused: {kept}; wait for it, or --force to stop "
                      f"it anyway", file=sys.stderr)
                ok = False
                continue
        action, detail = keeper.state_of(d, e)
        if action == keeper.PAUSED:
            print(f"{d}: " + (f"paused (window {w.id} stopped)" if w is not None and not w.dead
                               else f"already paused since {since}" if since
                               else "paused (it was not running)"))
        elif action == keeper.ELSEWHERE:
            print(f"{d}: paused, but its host runs outside crc (pid {detail}), and crc "
                  f"stops only what it started; exit it yourself (Ctrl-C an rc host, "
                  f"/exit a terminal session)", file=sys.stderr)
            ok = False
        elif action == keeper.OCCUPIED:
            print(f"{d}: paused, but another claude rc (pid {detail}), not crc's, is "
                  f"serving the folder", file=sys.stderr)
            ok = False
        else:
            print(f"{d}: paused, but it is still {action} ({detail})", file=sys.stderr)
            ok = False
        if left:
            print(f"{d}: still running from its window after the stop: "
                  + ", ".join(f"pid {p} ({n})" for p, n in left), file=sys.stderr)
            ok = False
    return 0 if ok else 1


def cmd_resume(a):
    """Start paused hosts again, the way restore does: an rc host on its old
    environment with every session it was serving, a terminal host on its
    conversation. A folder that is missing (unmounted?) stays paused."""
    entries = keeper.load()
    ds = targets(a, entries)
    todo, ok = [], True
    for d in ds:
        if not entries[d].get("paused"):
            print(f"{d}: not paused; left as it is")
        elif not os.path.isdir(d):
            print(f"{d}: folder missing (unmounted?); still paused", file=sys.stderr)
            ok = False
        else:
            todo.append(d)
    if any(keeper.kind(entries[d]) == "rc" for d in todo) and keeper.sync_all(entries):
        keeper.save(entries)
    for d in todo:
        e = entries[d]
        del e["paused"]
        ok &= keeper.restore_one(d, e)
        keeper.save(entries)
    return 0 if ok else 1


def cmd_poke(a):
    """Hand live rc hosts back the sessions they stopped serving (see
    keeper.unserved), with the call restore uses; the host starts a child for
    each. Only ever run by hand: crc does not re-queue on its own, so it
    cannot loop on a session that keeps dying."""
    entries = keeper.load()
    ds = targets(a, entries)
    server = keeper.fetch_server_sessions(lambda m: print(f"crc: {m}", file=sys.stderr))
    if server is None:
        die("only the server can say which sessions are disconnected; try again later")
    live = bridge.live_sessions()
    ok, poked = True, []
    for d in ds:
        e = entries[d]
        if keeper.kind(e) != "rc":
            print(f"{d}: a terminal host serves its one session itself; nothing to poke")
            continue
        p = bridge.read_pointer(d)
        todo = keeper.unserved(e, p, p is not None and bridge.host_alive(p), server, live)
        if todo is None:
            if e.get("paused"):
                print(f"{d}: paused; `crc resume` starts it with its sessions")
            else:
                print(f"{d}: its host is not running; `crc restore` starts it with "
                      f"its sessions", file=sys.stderr)
                ok = False
            continue
        if not todo:
            print(f"{d}: every session is being served")
        for sid in todo:
            if a.dry_run:
                print(f"{d}: would re-queue {sid}")
                continue
            try:
                bridge.reconnect(e["environment_id"], sid)
                print(f"{d}: re-queued {sid}")
                poked.append((d, p.pid, sid))
            except bridge.BridgeError as err:
                print(f"{d}: could not re-queue {sid}: {err}", file=sys.stderr)
                ok = False
    deadline = time.monotonic() + 30
    while poked and time.monotonic() < deadline:
        time.sleep(2)
        live = bridge.live_sessions()
        for d, pid, sid in list(poked):
            if sid in bridge.host_sessions(pid, live):
                print(f"{d}: {sid} is served again")
                poked.remove((d, pid, sid))
    for d, pid, sid in poked:
        print(f"{d}: {sid} was re-queued, but no child has it after 30s; "
              f"`crc attach` to look", file=sys.stderr)
        ok = False
    return 0 if ok else 1


def cmd_move(a):
    """Carry a kept session to a folder the files were moved to.

    The new folder must already exist; crc moves sessions, not files. Copies
    the conversations to the new folder's project key, stops a crc-run host in
    the old folder, then restores in the new one: an rc host asks to reuse its
    old environment there, and a terminal session resumes its conversation.
    """
    old, new = folder(a.old), folder(a.new)
    if not os.path.isdir(new):
        die(f"{new} is not a directory; move the files there first")
    entries = keeper.load()
    e = entries.get(old)
    p = bridge.read_pointer(old)
    if e is None and p is not None:
        # Not kept, but a host ran there: move that, knowing only its first session.
        e = {"kind": "rc", "session_id": p.session_id, "environment_id": p.environment_id,
             "sessions": [], "name": os.path.basename(old) or old, "args": [],
             "added": keeper.now(), "last_status": "stopped", "last_error": None}
    if e is not None:
        # Re-queue every session the server has on the environment, including
        # idle ones the timer may not have recorded yet.
        added, _ = keeper.sync_one(old, e, bridge.live_sessions(),
                                   keeper.fetch_server_sessions(
                                       lambda m: print(f"crc: {m}", file=sys.stderr)))
        for sid in added:
            print(f"{old}: also moving {sid}")
    w = tmuxctl.window_for(old)
    if e is None:
        old_alive = False
    elif keeper.kind(e) == "interactive":
        old_alive = any(s.transcript_id == e["transcript_id"] and (w is None or s.pid != w.pid)
                        for s in bridge.live_sessions())
    else:
        old_alive = p is not None and bridge.host_alive(p) and (w is None or p.pid != w.pid)
    np = bridge.read_pointer(new)
    err = keeper.move_check(old, new, e, old_alive, new in entries, np,
                            np is not None and bridge.host_alive(np))
    if err:
        die(err)
    if w is not None and not w.dead:
        print(f"stopping {old} (window {w.id})")
    if w is not None:
        stop_window(w, keeper.kind(e) == "interactive")
    copied = bridge.copy_project(old, new)
    print(f"copied {len(copied)} conversation file(s) to {new}'s project")
    if e.get("name") == (os.path.basename(old) or old):
        e["name"] = os.path.basename(new) or new
    if e.pop("paused", None):
        print(f"{old} was paused; the move starts it in {new}")
    entries.pop(old, None)
    entries[new] = e
    keeper.save(entries)
    env_before = e.get("environment_id")
    ok = keeper.restore_one(new, e, trust=a.trust)
    keeper.save(entries)
    if not ok:
        die(f"{new} did not come up; `crc ls` shows why and `crc restore` retries. "
            f"{old} is no longer kept; its conversations are still there.")
    if keeper.kind(e) == "rc" and e["environment_id"] == env_before:
        # The environment now lives in new. Left in place, the old pointer would
        # send the next `claude rc` in old after it too.
        if p is not None and p.environment_id == env_before:
            bridge.remove_pointer(p)
        print(f"moved {old} -> {new}; same environment, so claude.ai links are unchanged")
    elif keeper.kind(e) == "rc":
        print(f"moved {old} -> {new}, but on a new environment {e['environment_id']}: "
              f"the claude.ai links changed and the old sessions stayed behind on "
              f"{env_before}. Their conversations were copied, so "
              f"`claude --resume <id>` in {new} can continue one; "
              f"`crc release {old}` drops the old registration.")
    else:
        print(f"moved {old} -> {new}")


def channel_lines(e):
    """How a host's development channels stand, for ls and channel."""
    ch = e.get("channels") or []
    if not ch:
        return []
    out = [f"channels {', '.join(ch)}; the warning is answered "
           + ("by crc" if e.get("accept_channels") else "by hand (`crc attach`)")]
    c = e.get("channel_check")
    if c is None or set(c["registered"]) | set(c["missing"]) | set(c.get("unchecked", [])) != set(ch):
        out.append("not checked: crc has not started it with these channels yet")
    elif c["missing"]:
        out.append(f"NOT up at the launch of {c['at']}: "
                   + "; ".join(f"{k}: {v}" for k, v in c["missing"].items()))
    elif c["registered"]:
        out.append(f"server running at the launch of {c['at']}"
                   + (f" (not checked: {', '.join(c['unchecked'])})" if c.get("unchecked") else ""))
    else:
        out.append("not checked: crc can check only server: channels")
    return out


def cmd_channel(a):
    """Development channels are MCP servers that push messages into the
    conversation. Only a terminal (-i) host can load them: `claude rc`
    rejects the flag. Changes apply from the host's next start by crc."""
    d = folder(a.dir)
    entries = keeper.load()
    e = entries.get(d)
    if e is None:
        die(f"{d} is not kept")
    if a.clear:
        for k in ("channels", "accept_channels", "channel_check"):
            e.pop(k, None)
    if a.channels:
        bad = [c for c in a.channels if not keeper.CHANNEL_ENTRY.match(c)]
        if bad:
            die(f"not a channel: {', '.join(bad)}; use server:NAME (a server in the "
                f"folder's .mcp.json) or plugin:NAME@MARKETPLACE")
        if keeper.kind(e) != "interactive":
            die(f"{d} is an rc host, and `claude rc` rejects "
                f"{keeper.CHANNEL_FLAG}; only a terminal host (crc new -i, or an "
                f"adopted `claude --remote-control`) can load channels")
        new = list(dict.fromkeys(a.channels))
        if new != e.get("channels"):
            # Consent to answer the warning covers the channels it was given for.
            if e.get("accept_channels") and a.accept is None:
                print("crc: channels changed, so crc no longer answers the warning; "
                      "pass --accept to have it answer for these", file=sys.stderr)
            e["channels"], e["accept_channels"] = new, False
            e.pop("channel_check", None)
    if a.accept is not None:
        if not e.get("channels"):
            die(f"{d} has no channels; name them first")
        e["accept_channels"] = a.accept
    keeper.save(entries)
    lines = channel_lines(e) or ["no channels"]
    print(f"{d}\n  " + "\n  ".join(lines))
    if a.channels or a.clear or a.accept is not None:
        print("  applies from its next start by crc; a running host keeps what it "
              "started with")


def cmd_release(a):
    d = folder(a.dir)
    p = bridge.read_pointer(d)
    if p is None:
        die(f"no bridge pointer for {d}; nothing recorded to release")
    if bridge.host_alive(p):
        die(f"its host is still running (pid {p.pid}); stop it first")
    e = keeper.load().get(d)
    if e and p.environment_id == e.get("environment_id") and not a.force:
        die(f"{p.environment_id} is the environment of the kept session; resuming "
            f"reuses it, so releasing it is not needed. --force to release anyway")
    try:
        keeper.release(p.environment_id, p)
    except bridge.BridgeError as err:
        die(str(err))
    print(f"released {p.environment_id} (session {p.session_id})")


def cmd_stale(a):
    """Every bridge pointer whose host is gone. Read-only."""
    kept = {e.get("environment_id"): d for d, e in keeper.load().items()}
    found = False
    for pdir, p in bridge.all_pointers():
        if bridge.host_alive(p):
            continue
        found = True
        d = bridge.project_cwd(pdir)
        print(f"{d or '(folder unknown: ' + os.path.basename(pdir) + ')'}\n"
              f"    {p.environment_id}  session {p.session_id}  "
              f"host pid {p.pid or '-'} gone")
        if p.environment_id in kept:
            print(f"    kept by crc for {kept[p.environment_id]}; restore reuses it, "
                  f"do not release")
        elif d:
            print(f"    release with: crc release {d}")
    if not found:
        print("no stale registrations recorded")


def unit_path():
    """The PATH the unit runs with: its own Environment= if it sets one, else
    the user manager's. None if neither can be read."""
    r = subprocess.run(["systemctl", "--user", "show", "-p", "Environment", "--value",
                        tmuxctl.UNIT], capture_output=True, text=True)
    for word in r.stdout.split():
        if word.startswith("PATH="):
            return word[len("PATH="):]
    r = subprocess.run(["systemctl", "--user", "show-environment"],
                       capture_output=True, text=True)
    for line in r.stdout.splitlines():
        if line.startswith("PATH="):
            return line[len("PATH="):]
    return None


def login_shell_finds(names):
    """Which of names a login shell finds, started the way the unit starts
    one: the unit's PATH, then $SHELL -lc."""
    env = {"HOME": os.path.expanduser("~"), "USER": os.environ.get("USER", ""),
           "LOGNAME": os.environ.get("LOGNAME", os.environ.get("USER", "")),
           "SHELL": tmuxctl.login_shell(),
           "PATH": unit_path() or "/usr/local/bin:/usr/bin:/bin"}
    if "LANG" in os.environ:
        env["LANG"] = os.environ["LANG"]
    script = "; ".join(f'command -v {n} >/dev/null && echo {n}' for n in names)
    try:
        r = subprocess.run([env["SHELL"], "-lc", script], env=env, text=True,
                           capture_output=True, stdin=subprocess.DEVNULL, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return set()
    return set(r.stdout.split())


def cmd_doctor(a):
    ok = True

    def check(label, good, hint=""):
        nonlocal ok
        ok &= bool(good)
        print(f"{'ok  ' if good else 'FAIL'} {label}" + ("" if good else f"\n     {hint}"))

    check("claude on PATH", shutil.which("claude"), "install Claude Code")
    check("tmux on PATH", shutil.which("tmux"), "pacman -S tmux")
    # What restore actually depends on: crc itself runs with the unit's PATH,
    # and kept sessions start through a login shell from there.
    up = unit_path()
    missing = [n for n in ("python3", "tmux", "systemctl")
               if up is None or not shutil.which(n, path=up)]
    check("python3, tmux and systemctl on the unit's PATH (how restore and sync run)",
          not missing, f"not found there: {', '.join(missing)}; `make install UNITPATH=...` "
          f"with a PATH that has them (see README), then systemctl --user daemon-reload")
    found = login_shell_finds(["claude", "crc"])
    shell = os.path.basename(tmuxctl.login_shell())
    profile = {"zsh": "~/.zprofile", "bash": "~/.bash_profile"}.get(shell, "~/.profile")
    check(f"claude on PATH in a clean {shell} login shell (how restore starts it)",
          "claude" in found, f"add claude's directory to PATH in {profile}")
    check(f"crc on PATH in a clean {shell} login shell (for use inside kept sessions)",
          "crc" in found, f"add {os.path.dirname(os.path.realpath(sys.argv[0]))} "
          f"to PATH in {profile}")
    try:
        bridge.access_token()
        check("Claude Code login token readable and current", True)
    except bridge.BridgeError as e:
        check("Claude Code login token readable and current", False, str(e))
    check("api.anthropic.com reachable", keeper.wait_network(timeout=5),
          "restore waits up to 2 minutes for the network at boot")
    check(f"{tmuxctl.UNIT} installed", tmuxctl.unit_installed(),
          "make install, then systemctl --user daemon-reload")
    en = subprocess.run(["systemctl", "--user", "is-enabled", tmuxctl.UNIT],
                        capture_output=True, text=True).stdout.strip()
    check(f"{tmuxctl.UNIT} enabled", en == "enabled",
          f"systemctl --user enable {tmuxctl.UNIT}")
    tm = subprocess.run(["systemctl", "--user", "is-enabled", "claude-rc-keeper-sync.timer"],
                        capture_output=True, text=True).stdout.strip()
    check("claude-rc-keeper-sync.timer enabled (records new sessions)", tm == "enabled",
          "systemctl --user enable --now claude-rc-keeper-sync.timer")
    linger = subprocess.run(["loginctl", "show-user", os.environ.get("USER", ""),
                             "-p", "Linger", "--value"],
                            capture_output=True, text=True).stdout.strip()
    check("lingering on (restore at boot, before login)", linger == "yes",
          "loginctl enable-linger  (without it, restore waits for your login)")
    for d, e in sorted(keeper.load().items()):
        action, detail = keeper.state_of(d, e)
        last = (e.get("last_error") or "").splitlines()[-1:] or [""]
        if action == keeper.STUCK:
            check(f"{d} serving", False, f"its window is {detail}; `crc attach` to "
                  f"look, or `crc restore` to start it again")
        elif action not in (keeper.RUNNING, keeper.ELSEWHERE) and "untrusted: " in last[0]:
            check(f"{d} trusted by Claude Code", False, last[0].split("untrusted: ", 1)[1])
        c = e.get("channel_check")
        if e.get("channels") and c is not None:
            check(f"{d} channel servers running at its last launch", not c["missing"],
                  "; ".join(f"{k}: {v}" for k, v in c["missing"].items()))
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(prog="crc", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("new", help="start claude rc in a folder and keep it")
    s.add_argument("dir", nargs="?")
    s.add_argument("--name", help="session name shown in claude.ai/code")
    s.add_argument("-i", "--interactive", action="store_true",
                   help="a terminal session with remote control, not a claude rc host")
    s.add_argument("--trust", action="store_true",
                   help="if Claude Code asks whether to trust the folder, answer yes")
    s.add_argument("--resume", metavar="ID",
                   help="continue this conversation (implies -i); copied to DIR if "
                        "it lives under another folder. Its claude.ai link changes")
    s.add_argument("--channel", action="append", default=[], metavar="CH",
                   help="load this development channel (implies -i; repeatable)")
    s.add_argument("--accept-channels", action="store_true",
                   help="let crc answer the development-channel warning (see crc channel)")
    s.set_defaults(fn=cmd_new)

    s = sub.add_parser("adopt", help="keep a session already running here")
    s.add_argument("dir", nargs="?")
    s.add_argument("--pid", type=int, help="which terminal session, if several")
    s.set_defaults(fn=cmd_adopt)

    s = sub.add_parser("ls", help="show kept sessions")
    s.add_argument("--json", action="store_true",
                   help="machine-readable, with session titles and pids")
    s.set_defaults(fn=cmd_ls)
    s = sub.add_parser("sync", help="record sessions opened on kept hosts")
    s.add_argument("--revive", action="store_true",
                   help="also start again hosts that stopped or lost the server (the timer)")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("restore", help="bring back every kept session")
    s.add_argument("--no-wait", action="store_true", help="skip waiting for the network")
    s.add_argument("--dry-run", action="store_true",
                   help="show what would be started, re-queued and released; change nothing")
    s.set_defaults(fn=cmd_restore)

    sub.add_parser("attach", help="attach to the crc tmux session").set_defaults(fn=cmd_attach)

    for cmd, fn, text in (("pause", cmd_pause, "stop kept hosts, and keep them stopped"),
                          ("resume", cmd_resume, "start paused hosts again")):
        s = sub.add_parser(cmd, help=text)
        s.add_argument("dirs", nargs="*", metavar="DIR")
        s.add_argument("--under", metavar="PATH",
                       help="every kept folder at or below PATH")
        if cmd == "pause":
            s.add_argument("--force", action="store_true",
                           help="stop a host even with a session mid-turn")
        s.set_defaults(fn=fn)

    s = sub.add_parser("poke", help="re-queue sessions a live rc host stopped serving")
    s.add_argument("dirs", nargs="*", metavar="DIR")
    s.add_argument("--under", metavar="PATH", help="every kept folder at or below PATH")
    s.add_argument("--dry-run", action="store_true", help="only show what it would re-queue")
    s.set_defaults(fn=cmd_poke)

    s = sub.add_parser("rm", help="stop keeping a folder")
    s.add_argument("dir")
    s.add_argument("--keep-registration", action="store_true",
                   help="leave the server registration in place")
    s.set_defaults(fn=cmd_rm)

    s = sub.add_parser("move", help="carry a kept session to a moved folder")
    s.add_argument("old")
    s.add_argument("new")
    s.add_argument("--trust", action="store_true",
                   help="if Claude Code asks whether to trust the folder, answer yes")
    s.set_defaults(fn=cmd_move)

    s = sub.add_parser("channel", help="development channels for a terminal host")
    s.add_argument("dir")
    s.add_argument("channels", nargs="*", metavar="CH",
                   help="server:NAME or plugin:NAME@MARKETPLACE; replaces the list")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--accept", action="store_true", default=None,
                   help="let crc answer the development-channel warning, only "
                        "when it lists exactly these channels")
    g.add_argument("--no-accept", dest="accept", action="store_false",
                   help="leave the warning for you to answer in `crc attach`")
    g.add_argument("--clear", action="store_true", help="drop all channels")
    s.set_defaults(fn=cmd_channel)

    s = sub.add_parser("release", help="release a dead host's stale registration")
    s.add_argument("dir", nargs="?")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_release)

    sub.add_parser("stale", help="list stale registrations in every folder"
                   ).set_defaults(fn=cmd_stale)

    sub.add_parser("doctor", help="check prerequisites").set_defaults(fn=cmd_doctor)

    # Split by hand: with an optional DIR positional, argparse would take the
    # first passthrough flag after `--` as DIR.
    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    a = ap.parse_args(argv)
    if extra and a.cmd != "new":
        ap.error("only `crc new` takes extra claude rc flags after --")
    a.args = extra
    if (a.cmd in ("new", "adopt", "move", "rm", "restore", "channel", "pause", "resume")
            or a.cmd == "sync" and not a.revive) and not getattr(a, "dry_run", False):
        # These start, stop or change hosts, or rewrite the registry; the
        # timer skips a round rather than race them.
        with keeper.locked():
            sys.exit(a.fn(a) or 0)
    sys.exit(a.fn(a) or 0)


if __name__ == "__main__":
    main()
